{
  "name": "mjkitchen-consumer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy": "npm run build && wrangler deploy",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply mjkitchen --local",
    "db:migrate:remote": "wrangler d1 migrations apply mjkitchen --remote",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:seed:local": "wrangler d1 execute mjkitchen --local --file=seed/menu.sql",
    "db:seed:remote": "wrangler d1 execute mjkitchen --remote --file=seed/menu.sql"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/allura": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
